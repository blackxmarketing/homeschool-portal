# Where the SQLite database lives. Point this at a persistent volume in production.
DATA_DIR=./data

# Signs login cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Optional. Enables AI tutor hints and parent weekly summaries.
# Without it the portal still works and uses the built-in hints.
ANTHROPIC_API_KEY=

# Optional. Natural teacher voices from ElevenLabs (see docs/UPDATING.md).
# Without it, teachers use the browser's built-in voice.
ELEVENLABS_API_KEY=
